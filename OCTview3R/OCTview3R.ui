       </widget>
      </item>
      <item>
       <widget class="QGroupBox" name="groupBox_threshold">
        <property name="enabled">
         <bool>false</bool>
        </property>
        <property name="minimumSize">
         <size>
          <width>0</width>
          <height>90</height>
         </size>
        </property>
        <property name="title">
         <string>Threshold</string>
        </property>
        <layout class="QGridLayout" name="thresholdLayout">
         <property name="horizontalSpacing">
          <number>8</number>
         </property>
         <item row="0" column="0">
          <widget class="QLabel" name="label_const_minThreshold">
           <property name="text">
            <string>Min</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QSlider" name="Slider_minThreshold">
           <property name="maximum">
            <number>255</number>
           </property>
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
          </widget>
         </item>
         <item row="0" column="2">
          <widget class="QSpinBox" name="minThresholdSpinBox"/>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="label_const_maxThreshold">
           <property name="text">
            <string>Max</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="QSlider" name="Slider_maxThreshold">
           <property name="maximum">
            <number>255</number>
           </property>
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
          </widget>
         </item>
         <item row="1" column="2">
          <widget class="QSpinBox" name="maxThresholdSpinBox"/>
         </item>
         <item row="2" column="1" colspan="2">
          <widget class="QCheckBox" name="checkBox_smoothOpacity">
           <property name="toolTip">
            <string>Grayscale volumes: fade linearly from transparent at Min to the selected opacity at Max. Off: use uniform opacity with a hard cutoff. Source zero stays transparent in 3D; slice planes keep opaque black pixels. RGB keeps its luminance mask.</string>
           </property>
           <property name="text">
            <string>Smooth opacity (Min to Max)</string>
           </property>
           <property name="checked">
            <bool>true</bool>
           </property>
          </widget>
         </item>
        </layout>
       </widget>
      </item>
      <item>
       <spacer name="verticalSpacer">
        <property name="orientation">
         <enum>Qt::Vertical</enum>
        </property>
        <property name="sizeHint" stdset="0">
         <size>
          <width>20</width>
          <height>40</height>
         </size>
        </property>
       </spacer>
      </item>
     </layout>
    </widget>
   </widget>
  </widget>
  <widget class="QDockWidget" name="dockWidget_visualization">
   <property name="allowedAreas">
    <set>Qt::RightDockWidgetArea</set>
   </property>
   <property name="windowTitle">
    <string>Visualization</string>
   </property>
   <attribute name="dockWidgetArea">
    <number>2</number>
   </attribute>
   <widget class="QWidget" name="dockWidgetContents">
    <layout class="QVBoxLayout" name="visualizationLayout">
     <property name="spacing"><number>6</number></property>
     <item>
      <widget class="QWidget" name="viewerBrandHeader" native="true">
       <layout class="QHBoxLayout" name="viewerBrandLayout">
        <property name="leftMargin"><number>10</number></property>
        <property name="topMargin"><number>2</number></property>
        <property name="rightMargin"><number>8</number></property>
        <property name="bottomMargin"><number>2</number></property>
        <item>
         <spacer name="viewerBrandSpacer">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
         </spacer>
        </item>
        <item>
         <widget class="QLabel" name="viewerBrandName">
          <property name="font"><font><family>Segoe UI</family><pointsize>12</pointsize><bold>true</bold></font></property>
          <property name="text"><string>OCTview3R</string></property>
          <property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="viewerBrandLogo">
          <property name="minimumSize"><size><width>48</width><height>48</height></size></property>
          <property name="maximumSize"><size><width>48</width><height>48</height></size></property>
          <property name="accessibleName"><string>OCTview3R logo</string></property>
          <property name="toolTip"><string>OCT volumes and segmented surfaces in a shared 3D space</string></property>
          <property name="pixmap"><pixmap resource="OCTview3R.qrc">:/OCTview3R/Resources/branding/octview3r-ui.png</pixmap></property>
          <property name="scaledContents"><bool>true</bool></property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QVTKOpenGLWidget" name="qvtkWidget" native="true">
       <property name="sizePolicy">
        <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
         <horstretch>1</horstretch>
         <verstretch>1</verstretch>
        </sizepolicy>
       </property>
       <property name="minimumSize">
        <size>
         <width>300</width>
         <height>300</height>
        </size>
       </property>
      </widget>
     </item>
    </layout>
   </widget>
  </widget>
