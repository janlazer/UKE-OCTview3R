  <property name="windowTitle">
   <string>OCTview3R</string>
  </property>
  <property name="windowIcon">
   <iconset resource="OCTview3R.qrc">
    <normaloff>:/OCTview3R/Resources/branding/octview3r-ui.png</normaloff>:/OCTview3R/Resources/branding/octview3r-ui.png</iconset>
  </property>
  <property name="styleSheet">
   <string notr="true">/*
 * OCTview3R compact dark theme: graphite surfaces and cyan OCT-volume accents.
 * Keep font sizes native; save space through padding, not smaller text.
 * All static styling, palette and sizing are owned by this Designer form.
 *
 * Portions of the visual language are adapted from
 * Qt-Frameless-Window-DarkStyle by Juergen Skrotzky.
 * Source: https://github.com/Jorgen-VikingGod/Qt-Frameless-Window-DarkStyle
 * Licensed under the MIT License; see Resources/darkstyle/LICENSE.txt.
 */

/* Dock widgets are window boundaries: explicit foreground/surface rules keep
 * previews independent of Designer's own (possibly light) application palette. */
QWidget { color: #e1ebf0; }
QWidget:disabled { color: #7b8d99; }
QScrollArea, QWidget#dockWidgetContents_3 { background-color: #192129; }
QMainWindow, QDialog {
    background-color: #192129;
    color: #e1ebf0;
}
QToolTip {
    color: #e1ebf0;
    background-color: #1f2d38;
    border: 1px solid #40c7db;
    border-radius: 4px;
    padding: 3px 5px;
}
QMenuBar, QStatusBar {
    background-color: #11181f;
    color: #e1ebf0;
}
QMenuBar { border-bottom: 1px solid #2e3e4a; }
QStatusBar { border-top: 1px solid #2e3e4a; }
QMenuBar::item {
    padding: 2px 7px;
    background: transparent;
}
QMenuBar::item:selected { background-color: #263d4a; }
QMenuBar::item:pressed { color: #67d9e8; }
QMenu {
    background-color: #1d2933;
    border: 1px solid #435766;
}
QMenu::item { padding: 3px 24px 3px 20px; }
QMenu::item:selected {
    color: #e1f8fb;
    background-color: #244755;
}
QMenu::item:disabled { color: #7b8d99; }
QMenu::separator {
    height: 1px;
    margin: 3px 6px;
    background-color: #354957;
}
QToolBar {
    spacing: 2px;
    padding: 2px;
    background-color: #19232c;
    border: 0;
    border-bottom: 1px solid #31505e;
}
QToolBar::separator {
    width: 1px;
    margin: 3px;
    background-color: #354957;
}
QToolButton {
    min-width: 18px;
    min-height: 18px;
    padding: 2px;
    border: 1px solid transparent;
    border-radius: 4px;
    background: transparent;
}
QToolButton:hover {
    border-color: #3c6475;
    background-color: #263d4a;
}
QToolButton:pressed, QToolButton:checked {
    color: #83e5ef;
    border-color: #40c7db;
    background-color: #23414f;
}
QToolButton:disabled { color: #7b8d99; }
QToolButton:focus { border-color: #40c7db; }
QMainWindow::separator {
    width: 4px;
    height: 4px;
    background-color: #11181f;
}
QMainWindow::separator:hover, QSplitter::handle:hover {
    background-color: #40c7db;
}
QDockWidget { background-color: #192129; }
QDockWidget::title {
    padding: 3px 6px;
    background-color: #14212b;
    border-bottom: 1px solid #31505e;
    color: #b5dbe5;
}
QGroupBox {
    margin-top: 16px;
    padding-top: 2px;
    border: 1px solid #2e3e4a;
    border-radius: 5px;
    background-color: #1d2832;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 1px 5px;
    color: #b5dbe5;
}
QTabWidget::pane {
    border: 1px solid #2e3e4a;
    border-radius: 3px;
    background-color: #19232c;
}
QTabBar { qproperty-drawBase: 0; }
QTabBar::tab {
    min-width: 48px;
    padding: 3px 7px;
    margin-right: 2px;
    color: #9fb5c3;
    background-color: #14202a;
    border: 1px solid #2e3e4a;
    border-bottom: 2px solid transparent;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:hover { background-color: #263b49; }
QTabBar::tab:selected {
    color: #e1f8fb;
    background-color: #243744;
    border-bottom: 2px solid #40c7db;
}
QPushButton {
    min-height: 18px;
    padding: 2px 6px;
    border: 1px solid #3a5161;
    border-radius: 4px;
    background-color: #222f3b;
    color: #e1ebf0;
}
/* Only the dataset swatch colour changes at runtime; padding stays here. */
QPushButton#pushButton_pickVolumeColor, QPushButton#pushButton_pickPolyColor {
    padding: 0;
    min-height: 18px;
}
QPushButton:hover {
    border-color: #40c7db;
    background-color: #2c4555;
}
QPushButton:focus, QPushButton:default { border-color: #40c7db; }
QPushButton:pressed, QPushButton:checked {
    border-color: #40c7db;
    background-color: #23414f;
}
QPushButton:disabled {
    color: #7b8d99;
    border-color: #2c3b47;
    background-color: #1d2832;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    min-height: 18px;
    padding: 1px 4px;
    border: 1px solid #354957;
    border-radius: 4px;
    background-color: #11181f;
    color: #e1ebf0;
    selection-background-color: #40c7db;
    selection-color: #0d1e26;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #506b7c;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #40c7db;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: #7b8d99;
    border-color: #2c3b47;
    background-color: #18222b;
}
QComboBox { padding-right: 20px; }
QComboBox::drop-down {
    width: 18px;
    border: 0;
    border-left: 1px solid #354957;
}
QComboBox::down-arrow {
    image: url(:/OCTview3R/Resources/darkstyle/chevron-down.svg);
    width: 12px;
    height: 12px;
}
QComboBox QAbstractItemView {
    border: 1px solid #435766;
    background-color: #1d2933;
    color: #e1ebf0;
    selection-background-color: #40c7db;
    selection-color: #0d1e26;
}
QSpinBox, QDoubleSpinBox { padding-right: 18px; }
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    border-left: 1px solid #354957;
    border-top-right-radius: 4px;
    background-color: #24333f;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    border-left: 1px solid #354957;
    border-bottom-right-radius: 4px;
    background-color: #24333f;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #365566;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/OCTview3R/Resources/darkstyle/chevron-up.svg);
    width: 10px;
    height: 10px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/OCTview3R/Resources/darkstyle/chevron-down.svg);
    width: 10px;
    height: 10px;
}
QCheckBox { spacing: 4px; }
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #587080;
    border-radius: 3px;
    background-color: #11181f;
}
QCheckBox::indicator:hover { border-color: #40c7db; }
QCheckBox::indicator:checked {
    image: url(:/OCTview3R/Resources/darkstyle/check.svg);
    border-color: #40c7db;
    background-color: #40c7db;
}
QCheckBox::indicator:disabled { border-color: #354957; background-color: #1b2730; }
QCheckBox::indicator:checked:disabled { background-color: #68818f; }
QCheckBox:focus { color: #83e5ef; }
QProgressBar {
    min-height: 16px;
    border: 1px solid #354957;
    border-radius: 4px;
    background-color: #11181f;
    color: #e1ebf0;
    text-align: center;
}
QProgressBar::chunk {
    border-radius: 3px;
    background-color: #21687b;
}
QSlider::groove:horizontal {
    height: 5px;
    border-radius: 2px;
    background-color: #0f1820;
}
QSlider::handle:horizontal {
    width: 14px;
    margin: -5px 0;
    border: 1px solid #55cfdf;
    border-radius: 7px;
    background-color: #b9edf3;
}
QSlider::handle:horizontal:hover, QSlider::handle:horizontal:pressed {
    background-color: #40c7db;
}
QSlider:focus { border: 1px solid #40c7db; border-radius: 3px; }
QSlider::sub-page:horizontal { border-radius: 2px; background-color: #40c7db; }
QSlider::sub-page:horizontal:disabled { background-color: #3b515f; }
QSlider::handle:horizontal:disabled { border-color: #4b6372; background-color: #334956; }
QScrollBar:vertical { width: 13px; margin: 0; background: #11181f; }
QScrollBar::handle:vertical {
    min-height: 24px;
    margin: 2px 3px;
    border-radius: 3px;
    background-color: #435e70;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: #40c7db;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; background: none; }
QScrollBar:horizontal { height: 13px; margin: 0; background: #11181f; }
QScrollBar::handle:horizontal {
    min-width: 24px;
    margin: 3px 2px;
    border-radius: 3px;
    background-color: #435e70;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractItemView, QTableView, QTreeView {
    alternate-background-color: #192129;
    background-color: #11181f;
    border: 1px solid #354957;
    color: #e1ebf0;
    selection-background-color: #40c7db;
    selection-color: #0d1e26;
}
QHeaderView::section {
    padding: 3px 5px;
    border: 0;
    border-right: 1px solid #354957;
    border-bottom: 1px solid #354957;
    background-color: #24333f;
}
QLabel:disabled, QCheckBox:disabled, QRadioButton:disabled, QGroupBox:disabled {
    color: #7b8d99;
}
QWidget#viewerBrandHeader {
    background-color: #19232c;
    border-bottom: 1px solid #31505e;
}
QLabel#viewerBrandName, QLabel#applicationNameLabel { color: #a8e9f2; }
QLabel#descriptionLabel, QLabel#technologyLabel { color: #abc0ce; }
QLabel#versionLabel { color: #68d4e4; }</string>
